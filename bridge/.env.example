# Copy to bridge/.env
KANAKKU_URL=https://kanakku-kappa.vercel.app
# Only these numbers get replies (country code, no +). Add teammates and the demo phone.
BRIDGE_ALLOW=918943262406
# Optional: the bridge's own WhatsApp number, to link with an 8-digit code instead of scanning a QR
BRIDGE_PHONE=

# Who gets Kanakku's own daily messages (default: the first number in BRIDGE_ALLOW)
# BRIDGE_OWNER=91XXXXXXXXXX
# When to send them, in this laptop's time. Use "off" to stop one.
# DIGEST_MORNING=08:00
# DIGEST_EVENING=21:00

# If the app is locked with a shop PIN (SHOP_PIN in Vercel), put the same PIN here
# SHOP_PIN=
