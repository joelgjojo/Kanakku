# Copy this file to .env.local and fill in what you have.
# The app runs with NONE of these set (offline parser + data saved on your computer).

# --- AI (needed for voice, notebook photos and shelf check) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. The app tries these in order if one is unavailable:
# gemini-3.6-flash, gemini-3-flash-preview, gemini-3.1-flash-lite, gemini-2.5-flash
GEMINI_MODEL=

# --- Shop details shown in the app and in WhatsApp messages ---
NEXT_PUBLIC_SHOP_NAME=Ammu Stores
# Supplier's WhatsApp number with country code, no + (for "Send order to supplier")
NEXT_PUBLIC_SUPPLIER_PHONE=
# Shown in pattu reminders so customers can pay by UPI
NEXT_PUBLIC_UPI_ID=

# --- Cloud database (optional; leave empty to save to .data/kanakku.json) ---
# Run supabase/schema.sql in the Supabase SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Real WhatsApp via Meta's free Cloud API (recommended; no card needed) ---
# developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret word you choose; type the same word in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Optional: App settings → Basic → App secret (checks messages really come from Meta)
META_APP_SECRET=

# --- Or WhatsApp via Twilio (needs a paid/upgraded Twilio account to reply) ---
it) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public address of the app, e.g. https://kanakku.vercel.app or your ngrok URL
PUBLIC_URL=
NEXT_PUBLIC_PUBLIC_URL=
# Set to false only if signature checks fail while testing with ngrok
TWILIO_VALIDATE=true

# Optional backup free keys (teammates' Google accounts). Used when the first key hits its daily limit.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
